# Copie este arquivo para .env no servidor antes de subir os containers:
#   cp .env.docker.example .env
#
# Troque senhas e chaves. O banco Docker começa vazio
# (volume novo). Para zerar de novo: docker compose down -v
#
# Evite @ : / ? # na senha do Postgres — ela entra na DATABASE_URL.

POSTGRES_USER=nrlearn
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=nrlearn

APP_DOMAIN=fireprevencao.adelweb.com.br
AUTH_SECRET=troque_por_um_secret_longo_e_aleatorio
AUTH_URL=https://fireprevencao.adelweb.com.br

# Traefik (igual ao AdelAtende / AdelMsp)
TRAEFIK_NETWORK=proxy
